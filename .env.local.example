# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings → API in the Supabase dashboard).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Used for the site's canonical URL in auth email redirects.
# In local dev this is fine as-is. In production, set it to your real domain
# in Vercel's Environment Variables (https://matfinderbjj.com).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
